package com.myetherwallet.mewwalletkit.solana

import com.myetherwallet.mewwalletkit.bip.bip44.PublicKey
import com.myetherwallet.mewwalletkit.solana.core.SolanaPublicKey
import com.myetherwallet.mewwalletkit.solana.crypto.SolanaPrivateKey
import com.myetherwallet.mewwalletkit.solana.crypto.SolanaSignature
import com.myetherwallet.mewwalletkit.solana.encoding.ShortVec
import com.myetherwallet.mewwalletkit.solana.transaction.SolanaTransaction
import com.myetherwallet.mewwalletkit.solana.program.SystemProgram
import com.myetherwallet.mewwalletkit.solana.bip44.SolanaWallet
import org.junit.Test
import org.junit.Assert.*

/**
 * Comprehensive tests for Solana functionality
 * Tests all major components working together
 */
class SolanaComprehensiveTest {

    @Test
    fun testFullCryptoFlow() {
        // 1. Generate private key
        val privateKey = SolanaPrivateKey.generate()
        val publicKey = privateKey.publicKey()

        // 2. Test key properties
        assertEquals(32, privateKey.seed().size)
        assertEquals(32, publicKey.data().size)
        assertNotNull(publicKey.toSolanaBase58()!!)
        assertTrue(publicKey.toSolanaBase58()!!.isNotEmpty())

        // 3. Test signing and verification
        val message = "Hello Solana!".toByteArray()
        val signature = privateKey.sign(message)

        assertEquals(64, signature.bytes().size)
        assertTrue(signature.verify(message, publicKey))
        assertFalse(signature.verify("Wrong message".toByteArray(), publicKey))

        // 4. Test serialization formats
        val base58Address = publicKey.toSolanaBase58()!!

        assertEquals(publicKey, PublicKey.fromSolanaBase58(base58Address))
    }

    @Test
    fun testDeterministicKeys() {
        val seed = ByteArray(32) { (it + 1).toByte() }

        val privateKey1 = SolanaPrivateKey.fromSeed(seed)
        val privateKey2 = SolanaPrivateKey.fromSeed(seed)

        // Same seed should produce same keys
        assertEquals(privateKey1.publicKey(), privateKey2.publicKey())

        // Same message should produce same signature
        val message = "test message".toByteArray()
        val sig1 = privateKey1.sign(message)
        val sig2 = privateKey2.sign(message)

        assertEquals(sig1.toBase58(), sig2.toBase58())
    }

    @Test
    fun testShortVecEncoding() {
        // Test various lengths to ensure proper encoding
        val testCases = listOf(0, 1, 127, 128, 255, 256, 16383, 16384)

        testCases.forEach { length ->
            val encoded = ShortVec.encodeLength(length)
            val offset = intArrayOf(0)
            val decoded = ShortVec.decodeLength(encoded, offset)

            assertEquals("Failed for length $length", length, decoded)
            assertEquals("Wrong offset for length $length", encoded.size, offset[0])
        }
    }

    @Test
    fun testTransactionCreation() {
        val privateKey = SolanaPrivateKey.generate()
        val publicKey = privateKey.publicKey()
        val recipient = PublicKey.fromSolanaBase58("11111111111111111111111111111111")

        // Create a simple transfer transaction
        val transaction = SolanaTransaction()
        transaction.recentBlockhash = "11111111111111111111111111111111"
        transaction.feePayer = publicKey

        // Add transfer instruction
        val lamports = 1000000L // 0.001 SOL
        val transferInstruction = SystemProgram.transfer(
            fromPubkey = publicKey,
            toPubkey = recipient,
            lamports = lamports
        )

        transaction.addInstruction(transferInstruction)

        // Test transaction properties
        assertEquals(1, transaction.instructions.size)
        assertEquals(publicKey, transaction.feePayer)

        // Sign and serialize
        transaction.sign(privateKey)
        val serialized = transaction.serialize()

        assertTrue(serialized.isNotEmpty())
        assertEquals(1, transaction.signatures.size)
        assertTrue(transaction.signatures[0].isValid())
    }

    @Test
    fun testSystemProgramInstructions() {
        val from = SolanaPrivateKey.generate().publicKey()
        val to = SolanaPrivateKey.generate().publicKey()
        val lamports = 5000000L

        val transferInstruction = SystemProgram.transfer(
            fromPubkey = from,
            toPubkey = to,
            lamports = lamports
        )

        // Verify instruction structure
        assertEquals(SystemProgram.PROGRAM_ID, transferInstruction.programId)
        assertEquals(2, transferInstruction.accounts.size)

        // Verify account metadata
        assertEquals(from, transferInstruction.accounts[0].publicKey)
        assertTrue(transferInstruction.accounts[0].isSigner)
        assertTrue(transferInstruction.accounts[0].isWritable)

        assertEquals(to, transferInstruction.accounts[1].publicKey)
        assertFalse(transferInstruction.accounts[1].isSigner)
        assertTrue(transferInstruction.accounts[1].isWritable)
    }

    @Test
    fun testBIP44WalletIntegration() {
        // Test wallet generation
        val wallet = SolanaWallet.generate()

        // Test multiple account derivation
        val account0 = wallet.getAddress(0)
        val account1 = wallet.getAddress(1)
        val account2 = wallet.getAddress(2)

        // All addresses should be valid and unique
        assertTrue(Solana.isValidAddress(account0))
        assertTrue(Solana.isValidAddress(account1))
        assertTrue(Solana.isValidAddress(account2))

        assertNotEquals(account0, account1)
        assertNotEquals(account1, account2)
        assertNotEquals(account0, account2)
    }

    @Test
    fun testMnemonicWalletRestore() {
        val mnemonic = "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
        val wallet = SolanaWallet.fromMnemonic(mnemonic)

        val address = wallet.getAddress(0)
        assertTrue(Solana.isValidAddress(address))

        // Same mnemonic should produce same address
        val wallet2 = SolanaWallet.fromMnemonic(mnemonic)
        assertEquals(address, wallet2.getAddress(0))
    }

    @Test
    fun testSolanaUtilities() {
        // Test SOL to lamports conversion
        assertEquals(1_000_000_000L, Solana.solToLamports(1.0))
        assertEquals(500_000_000L, Solana.solToLamports(0.5))
        assertEquals(1_000L, Solana.solToLamports(0.000001))

        // Test lamports to SOL conversion
        assertEquals(1.0, Solana.lamportsToSol(1_000_000_000L), 0.0001)
        assertEquals(0.5, Solana.lamportsToSol(500_000_000L), 0.0001)
        assertEquals(0.000001, Solana.lamportsToSol(1_000L), 0.0000001)
    }

    @Test
    fun testAddressValidation() {
        val validAddresses = listOf(
            "11111111111111111111111111111111", // System Program
            "So11111111111111111111111111111111111111112", // Wrapped SOL
            "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM" // Random valid address
        )

        validAddresses.forEach { address ->
            assertTrue("Address $address should be valid", Solana.isValidAddress(address))
        }

        val invalidAddresses = listOf(
            "",
            "invalid",
            "123",
            "toolongaddressthatshouldnotbevalid1234567890123456789012345678901234567890",
            "1234567890123456789012345678901" // Too short
        )

        invalidAddresses.forEach { address ->
            assertFalse("Address $address should be invalid", Solana.isValidAddress(address))
        }
    }

    @Test
    fun testCompleteTransactionFlow() {
        // Create wallets
        val senderWallet = SolanaWallet.generate()
        val recipientWallet = SolanaWallet.generate()

        val senderPrivateKey = senderWallet.getPrivateKey(0)
        val senderAddress = senderPrivateKey.publicKey()
        val recipientAddress = recipientWallet.getPublicKey(0)

        // Create transfer transaction
        val lamports = Solana.solToLamports(0.1) // 0.1 SOL
        val recentBlockhash = "11111111111111111111111111111111" // Mock blockhash

        val transaction = Solana.createTransfer(
            from = senderAddress,
            to = recipientAddress,
            lamports = lamports,
            recentBlockhash = recentBlockhash
        )

        // Sign transaction
        transaction.sign(senderPrivateKey)

        // Verify transaction
        assertEquals(1, transaction.signatures.size)
        assertTrue(transaction.signatures[0].isValid())

        val serialized = transaction.serialize()
        assertTrue(serialized.isNotEmpty())

        // Verify transaction details
        assertEquals(senderAddress, transaction.feePayer)
        assertEquals(1, transaction.instructions.size)
        assertEquals(2, transaction.instructions[0].accounts.size)
    }

    @Test
    fun testSignatureValidation() {
        val privateKey = SolanaPrivateKey.generate()
        val publicKey = privateKey.publicKey()
        val wrongPrivateKey = SolanaPrivateKey.generate()
        val wrongPublicKey = wrongPrivateKey.publicKey()

        val message = "test signature validation".toByteArray()
        val signature = privateKey.sign(message)

        // Valid signature should verify
        assertTrue(signature.verify(message, publicKey))

        // Wrong public key should fail
        assertFalse(signature.verify(message, wrongPublicKey))

        // Wrong message should fail
        assertFalse(signature.verify("wrong message".toByteArray(), publicKey))

        // Empty signature should be invalid
        val emptySignature = SolanaSignature.empty()
        assertFalse(emptySignature.isValid())
        assertFalse(emptySignature.verify(message, publicKey))
    }
}