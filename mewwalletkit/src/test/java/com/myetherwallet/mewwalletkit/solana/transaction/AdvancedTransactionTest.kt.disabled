package com.myetherwallet.mewwalletkit.solana.transaction

import com.myetherwallet.mewwalletkit.bip.bip44.PublicKey
import com.myetherwallet.mewwalletkit.solana.crypto.SolanaPrivateKey
import com.myetherwallet.mewwalletkit.solana.program.SystemProgram
import com.myetherwallet.mewwalletkit.solana.token.TokenProgram
import com.myetherwallet.mewwalletkit.solana.token.AssociatedTokenProgram
import com.myetherwallet.mewwalletkit.solana.transaction.SolanaTransaction
import com.myetherwallet.mewwalletkit.solana.transaction.VersionedTransaction
import com.myetherwallet.mewwalletkit.solana.transaction.AddressLookupTable
import org.junit.Test
import org.junit.Assert.*

/**
 * Advanced transaction features test suite
 * Tests versioned transactions, batching, and modern Solana features
 */
class AdvancedTransactionTest {

    private val payer = SolanaPrivateKey.generate()
    private val recipient = SolanaPrivateKey.generate().publicKey()
    private val tokenMint = SolanaPrivateKey.generate().publicKey()
    private val recentBlockhash = "11111111111111111111111111111111"

    @Test
    fun testVersionedTransactionCreation() {
        // Should create V0 versioned transaction
        val payerPubkey = payer.publicKey()

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
            .build()

        assertNotNull("Versioned transaction should not be null", transaction)
        assertEquals("Should be version 0", 0, transaction.version)
        assertNotNull("Should have message", transaction.message)
        assertEquals("Should have 1 instruction", 1, transaction.message.instructions.size)
    }

    @Test
    fun testLegacyTransactionCompatibility() {
        // Should handle legacy transaction format
        val payerPubkey = payer.publicKey()

        val legacyTransaction = SolanaTransaction()
        legacyTransaction.feePayer = payerPubkey
        legacyTransaction.recentBlockhash = recentBlockhash
        legacyTransaction.addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))

        // Should be able to convert to versioned transaction
        val versionedTx = VersionedTransaction.fromLegacyTransaction(legacyTransaction)

        assertNotNull("Converted transaction should not be null", versionedTx)
        assertEquals("Should maintain same payer", payerPubkey, versionedTx.message.accountKeys[0])
        assertEquals("Should maintain same instruction count",
                    legacyTransaction.instructions.size, versionedTx.message.instructions.size)
    }

    @Test
    fun testBatchTransactionMultipleInstructions() {
        // Should handle multiple instructions in single transaction
        val payerPubkey = payer.publicKey()
        val recipient2 = SolanaPrivateKey.generate().publicKey()

        val sourceTokenAccount = AssociatedTokenProgram.getAssociatedTokenAddress(payerPubkey, tokenMint)
        val destTokenAccount = AssociatedTokenProgram.getAssociatedTokenAddress(recipient, tokenMint)

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            // SOL transfer
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
            // Token transfer
            .addInstruction(TokenProgram.transfer(sourceTokenAccount, destTokenAccount, payerPubkey, 500_000L))
            // Another SOL transfer
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient2, 2_000_000L))
            .build()

        assertNotNull("Batch transaction should not be null", transaction)
        assertEquals("Should have 3 instructions", 3, transaction.message.instructions.size)

        // Should compile correctly
        val compiled = transaction.compileMessage()
        assertNotNull("Should compile successfully", compiled)
        assertTrue("Should have multiple account keys", compiled.accountKeys.size > 3)
    }

    @Test
    fun testAddressLookupTableCreation() {
        // Should create Address Lookup Table (ALT)
        val authority = payer.publicKey()
        val recentSlot = 12345L

        val (createInstruction, lookupTableAddress) = AddressLookupTable.createLookupTable(
            authority = authority,
            payer = authority,
            recentSlot = recentSlot
        )

        assertNotNull("Create instruction should not be null", createInstruction)
        assertNotNull("Lookup table address should not be null", lookupTableAddress)

        // Address should be deterministic based on authority and slot
        val (_, lookupTableAddress2) = AddressLookupTable.createLookupTable(
            authority = authority,
            payer = authority,
            recentSlot = recentSlot
        )
        assertEquals("Lookup table address should be deterministic",
                    lookupTableAddress, lookupTableAddress2)
    }

    @Test
    fun testAddressLookupTableExtension() {
        // Should create instruction to extend lookup table
        val authority = payer.publicKey()
        val lookupTable = SolanaPrivateKey.generate().publicKey()

        val addressesToAdd = listOf(
            recipient,
            tokenMint,
            SolanaPrivateKey.generate().publicKey()
        )

        val instruction = AddressLookupTable.extendLookupTable(
            lookupTable = lookupTable,
            authority = authority,
            payer = authority,
            addresses = addressesToAdd
        )

        assertNotNull("Extend instruction should not be null", instruction)
        assertEquals("Should use Address Lookup Table Program",
                    AddressLookupTable.PROGRAM_ID, instruction.programId)
    }

    @Test
    fun testVersionedTransactionWithLookupTable() {
        // Should use lookup table to compress transaction size
        val payerPubkey = payer.publicKey()
        val lookupTable = SolanaPrivateKey.generate().publicKey()

        // Mock lookup table account data
        val lookupTableAccount = AddressLookupTable.AccountInfo(
            authority = payerPubkey,
            addresses = listOf(recipient, tokenMint)
        )

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
            .addLookupTable(lookupTable, lookupTableAccount)
            .build()

        assertNotNull("Transaction with lookup table should not be null", transaction)
        assertTrue("Should have lookup table references",
                  transaction.message.addressTableLookups.isNotEmpty())

        // Should compress account keys by using lookup table
        val serialized = transaction.serialize()
        assertNotNull("Should serialize successfully", serialized)
    }

    @Test
    fun testTransactionSizeComparison() {
        // Should demonstrate size savings with lookup tables
        val payerPubkey = payer.publicKey()

        // Create multiple recipients for larger transaction
        val recipients = (0..10).map { SolanaPrivateKey.generate().publicKey() }

        // Legacy transaction with all accounts
        val legacyTx = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)

        recipients.forEach { recipient ->
            legacyTx.addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
        }

        val legacyTransaction = legacyTx.build()
        val legacySize = legacyTransaction.serialize().size

        // Versioned transaction with lookup table
        val lookupTable = SolanaPrivateKey.generate().publicKey()
        val lookupTableAccount = AddressLookupTable.AccountInfo(
            authority = payerPubkey,
            addresses = recipients
        )

        val versionedTx = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            .addLookupTable(lookupTable, lookupTableAccount)

        recipients.forEach { recipient ->
            versionedTx.addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
        }

        val versionedTransaction = versionedTx.build()
        val versionedSize = versionedTransaction.serialize().size

        assertTrue("Versioned transaction should be smaller or equal",
                  versionedSize <= legacySize)
    }

    @Test
    fun testComplexBatchTransaction() {
        // Should handle complex multi-step transaction
        val payerPubkey = payer.publicKey()
        val tokenMint2 = SolanaPrivateKey.generate().publicKey()

        val sourceATA1 = AssociatedTokenProgram.getAssociatedTokenAddress(payerPubkey, tokenMint)
        val destATA1 = AssociatedTokenProgram.getAssociatedTokenAddress(recipient, tokenMint)
        val sourceATA2 = AssociatedTokenProgram.getAssociatedTokenAddress(payerPubkey, tokenMint2)
        val destATA2 = AssociatedTokenProgram.getAssociatedTokenAddress(recipient, tokenMint2)

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            // Create token accounts if needed
            .addInstruction(AssociatedTokenProgram.createAssociatedTokenAccount(
                payer = payerPubkey,
                owner = recipient,
                mint = tokenMint
            ))
            .addInstruction(AssociatedTokenProgram.createAssociatedTokenAccount(
                payer = payerPubkey,
                owner = recipient,
                mint = tokenMint2
            ))
            // Transfer tokens
            .addInstruction(TokenProgram.transfer(sourceATA1, destATA1, payerPubkey, 1_000_000L))
            .addInstruction(TokenProgram.transfer(sourceATA2, destATA2, payerPubkey, 2_000_000L))
            // Transfer SOL for fees
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 10_000_000L))
            .build()

        assertNotNull("Complex transaction should not be null", transaction)
        assertEquals("Should have 5 instructions", 5, transaction.message.instructions.size)

        // Should sign successfully
        transaction.sign(payer)
        assertTrue("Should have signatures", transaction.signatures.isNotEmpty())

        // Should serialize
        val serialized = transaction.serialize()
        assertTrue("Serialized transaction should have reasonable size",
                  serialized.size > 100 && serialized.size < 10000)
    }

    @Test
    fun testTransactionPriorityFees() {
        // Should handle priority fee instructions
        val payerPubkey = payer.publicKey()
        val priorityFeeMicroLamports = 1000L

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            .setPriorityFee(priorityFeeMicroLamports)
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
            .build()

        assertNotNull("Transaction with priority fee should not be null", transaction)

        // Should add compute budget instructions
        val instructions = transaction.message.instructions
        assertTrue("Should have at least 2 instructions (priority fee + transfer)",
                  instructions.size >= 2)

        // First instruction should be compute budget
        val firstInstruction = instructions[0]
        // ComputeBudgetProgram.PROGRAM_ID would be checked here
        assertNotNull("First instruction should not be null", firstInstruction)
    }

    @Test
    fun testTransactionSimulation() {
        // Should support transaction simulation (dry-run)
        val payerPubkey = payer.publicKey()

        val transaction = VersionedTransaction.builder()
            .setPayer(payerPubkey)
            .setRecentBlockhash(recentBlockhash)
            .addInstruction(SystemProgram.transfer(payerPubkey, recipient, 1_000_000L))
            .build()

        // Should be able to prepare for simulation
        val simulationData = transaction.getSimulationData()

        assertNotNull("Simulation data should not be null", simulationData)
        assertTrue("Should have account keys", simulationData.accounts.isNotEmpty())
        assertNotNull("Should have instruction data", simulationData.instructions)

        // Simulation data should be serializable
        val serialized = simulationData.serialize()
        assertTrue("Simulation data should serialize", serialized.isNotEmpty())
    }
}